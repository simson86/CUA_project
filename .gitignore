# ── 비밀/환경변수 (절대 커밋 금지) ──
.env
.env.*
!.env.example

# ── 파이썬 캐시/빌드 ──
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# ── 가상환경 ──
.venv/
venv/
env/

# ── 실행 중 생성물 ──
screen.png
*.png

# ── git 변경 리포트(생성물) ──
git_report.html
git_report*.html

# ── 로컬 임시 테스트 스크립트(공유 안 함) ──
/test_connect.py
/testscreen.py

# ── 벤치 결과·산출물(로컬 전용, 커밋 안 함) ──
예약_*.txt
*.pptx

# docs/reference/ 는 전부 공유한다(2026-08-13).
# 예전엔 android_run-*.md 를 로컬 전용으로 뒀는데, 구현 배경·실측 수치·함정이 거기
# 쌓이면서 팀원이 못 보는 게 손해가 됐다. 새 문서도 그냥 여기 두면 공유된다.
# ★ 넣기 전에 비밀이 섞이지 않았는지 볼 것 — API 키는 값 대신 `GEMINI_API_KEY=…` 로.

